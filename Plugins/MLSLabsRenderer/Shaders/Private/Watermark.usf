// Watermark plate, same small-rect idea as MLSLabsFPSOverlay.usf.
// The plate covers its whole rect, so the color is blended in hardware and this
// shader never reads SceneColor. A SceneColor copy ends the tile pass and stores
// every tile on Adreno, which is what drops Pico 4 Ultra off 90 fps.

#include "/Engine/Private/Common.ush"

Texture2D LogoTexture;
SamplerState LogoSampler;

float2 ViewRectMin;
float2 LogoSize;
float2 LogoOffset;
float BackgroundOpacity;

void WatermarkPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    float2 LocalPos = SvPosition.xy - ViewRectMin;
    float2 LogoUV = (LocalPos - LogoOffset) / max(LogoSize, float2(1.0, 1.0));
    float4 LogoColor = LogoTexture.SampleLevel(LogoSampler, saturate(LogoUV), 0);

    // lerp(scene, dark, opacity), then lerp in the straight logo color.
    // Coverage is the RGB blend factor. The pass writes render-target alpha to 0,
    // matching MLSLabsFPSOverlay: Pico MR treats alpha 1 as the camera hole.
    float3 DarkBg = float3(0.05, 0.05, 0.08);
    float LogoA = saturate(LogoColor.a);
    float KeepScene = (1.0 - BackgroundOpacity) * (1.0 - LogoA);
    float Coverage = saturate(1.0 - KeepScene);
    float3 Premul = DarkBg * BackgroundOpacity * (1.0 - LogoA) + LogoColor.rgb * LogoA;
    float3 SrcRgb = Premul / max(Coverage, 1.0e-4);
    OutColor = float4(SrcRgb, Coverage);
}