#ifndef MLSLABS_SCREEN_MAPPING_USH
#define MLSLABS_SCREEN_MAPPING_USH

// Pass-local pixel -> normalized [0,1] over the active pass viewport.
float2 MLSLabsPassNormFromLocal(float2 LocalPos, float2 PassSize)
{
    return (LocalPos + 0.5f) / max(PassSize, float2(1e-3f, 1e-3f));
}

// Normalized pass UV -> pixel coordinate in a buffer sub-rect (ViewRect / UnscaledViewRect).
float2 MLSLabsBufferPixelFromPassNorm(float2 PassNorm, float2 BufferViewRectMin, float2 BufferViewRectSize)
{
    return BufferViewRectMin + PassNorm * BufferViewRectSize;
}

int2 MLSLabsClampPixel(int2 Pixel, float2 BufferSize)
{
    int2 BufMax = max(int2(BufferSize) - int2(1, 1), int2(0, 0));
    return clamp(Pixel, int2(0, 0), BufMax);
}

int2 MLSLabsBufferPixelFromPassNormInt(float2 PassNorm, float2 BufferViewRectMin, float2 BufferViewRectSize, float2 BufferSize)
{
    float2 PixelF = MLSLabsBufferPixelFromPassNorm(PassNorm, BufferViewRectMin, BufferViewRectSize);
    return MLSLabsClampPixel(int2(PixelF), BufferSize);
}

// Splat depth -> UE linear depth (cm), or -1 where no splat wrote depth. The raster stores linear view-Z in metres
// past 1 m and device Z = near / Z closer; empty texels are 0 or >= 1e8 (reading those as near / Z would put soft
// colour fringes in front of everything and paint a silhouette halo).
float MLSLabsSplatLinearDepthCm(float EncodedDepth)
{
    if (EncodedDepth <= 0.0f || EncodedDepth >= 1.0e8f)
    {
        return -1.0f;
    }
    if (EncodedDepth > 1.0f)
    {
        return EncodedDepth * 100.0f;
    }
    return GetPrimaryView().NearPlane / max(EncodedDepth, 1e-6f);
}

#endif // MLSLABS_SCREEN_MAPPING_USH
