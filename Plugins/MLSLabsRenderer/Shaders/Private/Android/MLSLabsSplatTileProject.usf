// Android tile raster stage 1: ProjectCS projects every sorted (or foveation-compacted) splat of one source
// into its range of ProjectedSplats; Android/MLSLabsSplatTileCount.usf bins them into tiles.

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Plugin/MLSLabsRenderer/Private/Android/MLSLabsSplatFoveation.ush"

Buffer<uint> SortedIndices;
float4x4 LocalToWorld;
float4x4 WorldToClip;
float4x4 WorldToView;
float4x4 WorldToLocal;
float3 ViewOrigin;
float2 ViewSize;
uint SplatCount;
float MinimumProjectedRadius;
float MaximumProjectedRadius;
float MaximumAnisotropy;
float NearPlane;
float SHStrength;
uint SHDegree;
uint AdaptiveSHQuality;
float DensityFootprintExpansion;
uint UseCompact;

struct FProjectedSplat
{
	float4 AxesNdc;
	float4 Color;
	float ViewZMeters;
};

// Screen-space ellipse axes of one splat; false when it is culled. DensityStep > 1 grows the survivors of
// foveation thinning to keep their coverage; SHDensityStep picks the SH degree under AdaptiveSHQuality.
bool ProjectSplat(uint SplatIndex, float4 A, float4 CenterWorld, float4 CenterClip, float DensityStep, float SHDensityStep, out FProjectedSplat Splat)
{
	Splat = (FProjectedSplat)0;
	float4 B = SplatData[SplatIndex * 3u + 1u];
	float4 C = SplatData[SplatIndex * 3u + 2u];
	float3x3 Covariance = DecodeSplatCovariance(A, B, C);

	float SafeW = max(CenterClip.w, 1e-5);
	float2 CovarianceNdc = clamp(CenterClip.xy / SafeW, -1.3, 1.3);
	float2 D[3];
	[unroll] for (uint I = 0; I < 3; ++I)
	{
		float3 Basis = I == 0 ? float3(1, 0, 0) : (I == 1 ? float3(0, 1, 0) : float3(0, 0, 1));
		float4 AxisWorldDelta = mul(float4(Basis, 0), LocalToWorld);
		float4 AxisClipDelta = mul(AxisWorldDelta, WorldToClip);
		D[I] = (AxisClipDelta.xy - CovarianceNdc * AxisClipDelta.w) / SafeW * 0.5 * ViewSize;
	}
	float3 Jx = float3(D[0].x, D[1].x, D[2].x);
	float3 Jy = float3(D[0].y, D[1].y, D[2].y);
	float Cxx = dot(Jx, mul(Covariance, Jx)) + 0.3;
	float Cxy = dot(Jx, mul(Covariance, Jy));
	float Cyy = dot(Jy, mul(Covariance, Jy)) + 0.3;
	float Trace = Cxx + Cyy;
	float Disc = sqrt(max(0.0, (Cxx - Cyy) * (Cxx - Cyy) + 4.0 * Cxy * Cxy));
	float MaxRadius = max(MaximumProjectedRadius, MinimumProjectedRadius);
	float2 Eigen = clamp(sqrt(8.0 * max(float2(0.25, 0.25), 0.5 * float2(Trace + Disc, Trace - Disc))), 0.5, MaxRadius);
	float BaseProjectedRadius = max(Eigen.x, Eigen.y);
	float SourceOpacity = DecodeSplatOpacity(asuint(C.z));
	float TinyRepresentativeWeight = saturate((4.0 - BaseProjectedRadius) / 3.0);
	float TranslucentCoverageWeight =
		smoothstep(3.0, 16.0, BaseProjectedRadius)
		* pow(saturate(1.0 - SourceOpacity), 2.0);
	float FootprintExponent = max(
		DensityFootprintExpansion * TinyRepresentativeWeight,
		DensityFootprintExpansion * 1.75 * TranslucentCoverageWeight);
	float DensityFootprintScale = pow(DensityStep, FootprintExponent);
	Eigen *= DensityFootprintScale;
	if (MaximumAnisotropy > 1.0)
	{
		float MinEigen = max(min(Eigen.x, Eigen.y), 0.5);
		float MajorLimit = MinEigen * MaximumAnisotropy;
		Eigen = min(Eigen, float2(MajorLimit, MajorLimit));
	}
	if (max(Eigen.x, Eigen.y) < MinimumProjectedRadius)
	{
		return false;
	}

	float2 Major = normalize(abs(Cxy) > 1e-5
		? float2(Cxy, 0.5 * (Cyy - Cxx + Disc))
		: (Cxx >= Cyy ? float2(1, 0) : float2(0, 1)));
	float2 Minor = float2(-Major.y, Major.x);
	float2 MajorNdc = Major * Eigen.x * 2.0 / ViewSize;
	float2 MinorNdc = Minor * Eigen.y * 2.0 / ViewSize;
	if (any(isnan(MajorNdc)) || any(isinf(MajorNdc)) || length(MajorNdc) > 2.0 || length(MinorNdc) > 2.0)
	{
		return false;
	}

	float4 Color = DecodeSplatColor(C);
	uint EffectiveSHDegree = SHDegree;
	if (AdaptiveSHQuality != 0)
	{
		float EffectiveDensityLevel = log2(SHDensityStep);
		EffectiveSHDegree = EffectiveDensityLevel >= 3 ? 0 : (EffectiveDensityLevel >= 1 ? min(SHDegree, 1u) : SHDegree);
	}
	if (SHScale > 0.0 && EffectiveSHDegree > 0)
	{
		float3 CameraLocal = mul(float4(ViewOrigin, 1), WorldToLocal).xyz;
		float3 ViewColor = EvaluateSHRest(SplatIndex, normalize(A.xyz - CameraLocal), EffectiveSHDegree, false);
		Color.rgb = max(0.0, Color.rgb + ViewColor * SHStrength);
	}
	float OpticalDepthCopies = DensityStep / max(1.0, DensityFootprintScale * DensityFootprintScale);
	Color.a = 1.0 - pow(saturate(1.0 - Color.a), OpticalDepthCopies);

	float ViewZCm = max(mul(float4(CenterWorld.xyz, 1.0), WorldToView).z, 1e-3);
	float ViewZMeters = ViewZCm / 100.0;
	Splat.AxesNdc = float4(MajorNdc, MinorNdc);
	Splat.Color = Color;
	// Linear metres past 1 m, device Z (near / Z) closer: the encoding MLSLabsSplatLinearDepthCm decodes.
	Splat.ViewZMeters = (ViewZMeters > 1.0) ? ViewZMeters : (NearPlane / ViewZCm);
	return true;
}

Buffer<uint> CompactedIndices;
StructuredBuffer<uint> CompactCount;
RWStructuredBuffer<float4> RWProjectedSplats;
// First slot of this source in RWProjectedSplats; the sources of a view share one buffer.
uint ProjectedBase;

void WriteDegenerate(uint OutIndex)
{
	RWProjectedSplats[OutIndex * 4u + 0u] = float4(2.0, 2.0, 2.0, 1.0);
	RWProjectedSplats[OutIndex * 4u + 1u] = 0.0;
	RWProjectedSplats[OutIndex * 4u + 2u] = 0.0;
	RWProjectedSplats[OutIndex * 4u + 3u] = 0.0;
}

// Clears every slot of the view, so the slots a compacted source leaves unwritten stay degenerate.
[numthreads(128, 1, 1)]
void ClearProjectedCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint Index = DispatchThreadId.x;
	if (Index >= SplatCount)
	{
		return;
	}
	WriteDegenerate(Index);
}

[numthreads(128, 1, 1)]
void ProjectCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint Index = DispatchThreadId.x;
	uint LiveCount = UseCompact != 0u ? min(CompactCount[0], SplatCount) : SplatCount;
	if (Index >= LiveCount || Index >= SplatCount)
	{
		return;
	}
	uint OutIndex = ProjectedBase + Index;

	uint SplatIndex = UseCompact != 0 ? CompactedIndices[Index] : SortedIndices[Index];
	float4 A = SplatData[SplatIndex * 3u + 0u];
	float4 CenterWorld = mul(float4(A.xyz, 1.0), LocalToWorld);
	float4 CenterClip = mul(CenterWorld, WorldToClip);
	if (CenterClip.w <= 1e-5 || any(abs(CenterClip.xy) > CenterClip.w * 3.0))
	{
		WriteDegenerate(OutIndex);
		return;
	}

	float FoveatedDensityStep = 1.0;
	float ZoneDensityStep = 1.0;
	if (PeripheralOptimizationLevel != 0)
	{
		float Retention = GetFoveationRetention(GetFoveationRadiusForSplat(CenterWorld, CenterClip, ViewSize));
		bool bKeptOpaque = IsFoveationKeptOpaque(SplatIndex);
		// With UseCompact the compaction already dropped the unselected splats.
		if (UseCompact == 0 && !bKeptOpaque && !IsFoveationSelected(SplatIndex, Retention))
		{
			WriteDegenerate(OutIndex);
			return;
		}
		ZoneDensityStep = rcp(max(Retention, 1e-3));
		FoveatedDensityStep = bKeptOpaque ? 1.0 : ZoneDensityStep;
	}

	FProjectedSplat Splat;
	if (!ProjectSplat(SplatIndex, A, CenterWorld, CenterClip, FoveatedDensityStep, ZoneDensityStep, Splat))
	{
		WriteDegenerate(OutIndex);
		return;
	}
	RWProjectedSplats[OutIndex * 4u + 0u] = CenterClip;
	RWProjectedSplats[OutIndex * 4u + 1u] = Splat.Color;
	RWProjectedSplats[OutIndex * 4u + 2u] = Splat.AxesNdc;
	RWProjectedSplats[OutIndex * 4u + 3u] = float4(Splat.ViewZMeters, 0.0, 0.0, 0.0);
}
